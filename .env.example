# RiverGuard AI Environment Variables
SECRET_KEY=riverguard-ai-secret-key-2026-environmental-station
FLASK_ENV=development
FLASK_PORT=5000

# Water Level Thresholds (in meters)
SAFE_THRESHOLD=2.0
WATCH_THRESHOLD=2.0
WARNING_THRESHOLD=3.5
DANGER_THRESHOLD=4.8
MAX_GAUGE_HEIGHT=6.0

# SMTP Email Alert Configuration
# Set these to actual SMTP server credentials to enable real email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@riverguard.ai
ALERT_EMAIL_TO=operations@riverguard.ai
ALERT_COOLDOWN_SECONDS=900

# Twilio SMS & OTP Verification Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here


# OTP developer mode: true = print OTP in server terminal when SMS fails and accept test codes. Keep false.
OTP_DEV_MODE=false
